# Local runtime state (e.g. agent transcripts) lives under .scitex/.
# `.scitex/dev/config.yaml` is the only file in this tree we track —
# it carries the audit root-whitelist; everything else is local-only.
.scitex/*
!.scitex/dev/
.scitex/dev/*
!.scitex/dev/config.yaml
